# === DAEMON Environment Variables ===
# Copy this file to .env and fill in real values.
# NEVER commit .env files to the repository.

# Anthropic API key for Claude (agent only)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Shared secret between agent and site API
DAEMON_API_SECRET=your-long-random-secret-here

# Postgres connection string (site only — provided by Vercel)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Site URL (agent needs this to POST thoughts)
SITE_URL=http://localhost:3000
